# OpenAI API key
OPENAI_API_KEY=sk-...

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_name
# Твой личный chat_id — узнать у @userinfobot
TELEGRAM_ADMIN_CHAT_ID=123456789

# Настройки агента
POST_INTERVAL_MINUTES=60
MAX_POSTS_PER_RUN=3
MIN_UPVOTES=50
# Ключевые слова для фильтрации постов Hacker News
KEYWORDS=AI,machine learning,startup,automation,SaaS,LLM,agent,business,productivity,tool

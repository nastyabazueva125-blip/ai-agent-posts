# Reddit API (получить на https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ai-content-curator/1.0

# Anthropic (Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_name

# Настройки агента
POST_INTERVAL_MINUTES=60
MAX_POSTS_PER_RUN=3
MIN_UPVOTES=50
SUBREDDITS=smallbusiness,Entrepreneur,artificial,MachineLearning,webdev,SideProject
KEYWORDS=SMB,small business,AI agent,neural network,website,automation,startup
